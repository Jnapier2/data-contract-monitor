{
  "$defs": {
    "ColumnProfile": {
      "additionalProperties": false,
      "properties": {
        "distinct_count": {
          "title": "Distinct Count",
          "type": "integer"
        },
        "duplicate_count": {
          "title": "Duplicate Count",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "null_count": {
          "title": "Null Count",
          "type": "integer"
        },
        "null_ratio": {
          "title": "Null Ratio",
          "type": "number"
        },
        "observed_type": {
          "title": "Observed Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "observed_type",
        "null_count",
        "null_ratio",
        "distinct_count",
        "duplicate_count"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "DatasetProfile": {
      "additionalProperties": false,
      "properties": {
        "column_count": {
          "title": "Column Count",
          "type": "integer"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnProfile"
          },
          "title": "Columns",
          "type": "array"
        },
        "pii_signals": {
          "items": {
            "$ref": "#/$defs/PiiSignal"
          },
          "title": "Pii Signals",
          "type": "array"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "row_count",
        "column_count",
        "columns"
      ],
      "title": "DatasetProfile",
      "type": "object"
    },
    "DriftChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "change_type": {
          "enum": [
            "added",
            "removed",
            "type_changed",
            "nullability_changed"
          ],
          "title": "Change Type",
          "type": "string"
        },
        "column": {
          "title": "Column",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "change_type",
        "column",
        "severity"
      ],
      "title": "DriftChange",
      "type": "object"
    },
    "DriftSummary": {
      "additionalProperties": false,
      "properties": {
        "baseline_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Path"
        },
        "baseline_used": {
          "default": false,
          "title": "Baseline Used",
          "type": "boolean"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/DriftChange"
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "title": "DriftSummary",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "affected_rows": {
          "default": 0,
          "title": "Affected Rows",
          "type": "integer"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "sample_rows": {
          "items": {
            "type": "integer"
          },
          "title": "Sample Rows",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule_id",
        "severity",
        "category",
        "title",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "PiiSignal": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "column": {
          "title": "Column",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "match_ratio": {
          "default": 0,
          "title": "Match Ratio",
          "type": "number"
        },
        "matching_values": {
          "default": 0,
          "title": "Matching Values",
          "type": "integer"
        },
        "name_signal": {
          "title": "Name Signal",
          "type": "boolean"
        },
        "sampled_values": {
          "default": 0,
          "title": "Sampled Values",
          "type": "integer"
        }
      },
      "required": [
        "column",
        "category",
        "confidence",
        "name_signal"
      ],
      "title": "PiiSignal",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValidationSummary": {
      "additionalProperties": false,
      "properties": {
        "critical": {
          "title": "Critical",
          "type": "integer"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "fail_on": {
          "$ref": "#/$defs/Severity"
        },
        "findings_total": {
          "title": "Findings Total",
          "type": "integer"
        },
        "info": {
          "title": "Info",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "passed",
        "fail_on",
        "findings_total",
        "info",
        "warnings",
        "errors",
        "critical"
      ],
      "title": "ValidationSummary",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "completeness": {
      "default": "complete",
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "contract_label": {
      "title": "Contract Label",
      "type": "string"
    },
    "contract_sha256": {
      "title": "Contract Sha256",
      "type": "string"
    },
    "data_label": {
      "title": "Data Label",
      "type": "string"
    },
    "data_sha256": {
      "title": "Data Sha256",
      "type": "string"
    },
    "dataset_name": {
      "title": "Dataset Name",
      "type": "string"
    },
    "drift": {
      "$ref": "#/$defs/DriftSummary"
    },
    "duration_ms": {
      "title": "Duration Ms",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "findings_truncated": {
      "default": false,
      "title": "Findings Truncated",
      "type": "boolean"
    },
    "limits_applied": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          }
        ]
      },
      "title": "Limits Applied",
      "type": "object"
    },
    "privacy_note": {
      "default": "Reports contain aggregate statistics and row numbers, not raw cell values.",
      "title": "Privacy Note",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/DatasetProfile"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_format": {
      "title": "Source Format",
      "type": "string"
    },
    "source_standard_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Standard Version"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/ValidationSummary"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "tool_version",
    "run_id",
    "dataset_name",
    "contract_label",
    "data_label",
    "started_at",
    "completed_at",
    "duration_ms",
    "contract_sha256",
    "data_sha256",
    "source_format",
    "summary",
    "findings",
    "profile",
    "drift"
  ],
  "title": "ValidationResult",
  "type": "object"
}
